# Copy to .env for local dev. Real values live in Netlify env vars.
# Password for the hidden /admin page (where the OpenRouter key is set).
# Unset = /admin is switched off.
ADMIN_PASSWORD=
# OpenRouter key (openrouter.ai), one key for Claude and GPT. Fallback only:
# a key set on /admin wins. Leave empty in Netlify so removing the key on
# /admin really switches the apps off.
OPENROUTER_API_KEY=
# Comma-separated codes shown on the workshop slide.
WORKSHOP_CODES=
# Optional: per-code call cap per hour (default 3000).
WORKSHOP_HOURLY_CAP=
# Optional: OpenRouter model ids behind the Claude / GPT picker.
# Defaults: anthropic/claude-haiku-5.5 and openai/gpt-6-luna (same price tier).
# Stronger pair if needed: anthropic/claude-sonnet-5.5 and openai/gpt-6.1-sol.
LLM_TO_AGENT_CLAUDE_MODEL=
LLM_TO_AGENT_GPT_MODEL=
# Optional: how long tool results are shared before refetching (default 30).
# Raise to 90 for a workshop; scripts/prewarm.ts fills it before the session.
CACHE_MINUTES=
